{
  "name": "@rnctl/sdk",
  "version": "0.1.0",
  "description": "Public plugin API and shared types for rnctl",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bittu/rnctl.git"
  },
  "homepage": "https://github.com/bittu/rnctl#readme",
  "engines": {
    "node": ">=20"
  }
}
