{
  "name": "@rnctl/plugin-mcp",
  "version": "0.1.0",
  "description": "Local MCP server exposing rnctl state and actions to AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@rnctl/sdk": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bittu/rnctl.git"
  },
  "homepage": "https://github.com/bittu/rnctl#readme",
  "engines": {
    "node": ">=26.4.0"
  }
}
