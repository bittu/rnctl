{
  "name": "@rnctl/cli",
  "version": "0.1.0",
  "description": "One mission control for React Native",
  "type": "module",
  "bin": {
    "rnctl": "./dist/bin.js",
    "rnc": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@rnctl/web": "workspace:*"
  },
  "dependencies": {
    "@rnctl/core": "workspace:*",
    "@rnctl/plugin-devices": "workspace:*",
    "@rnctl/plugin-doctor": "workspace:*",
    "@rnctl/plugin-logs": "workspace:*",
    "@rnctl/plugin-metro": "workspace:*",
    "@rnctl/sdk": "workspace:*",
    "@rnctl/tui": "workspace:*",
    "commander": "^15.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bittu/rnctl.git"
  },
  "homepage": "https://github.com/bittu/rnctl#readme",
  "engines": {
    "node": ">=26.4.0"
  }
}
